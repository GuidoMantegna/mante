# Resend (formulario de contacto). Copiar a .env.local para desarrollo.
RESEND_API_KEY=re_xxx
# Casilla que recibe las consultas.
CONTACT_TO_EMAIL=mantemuebles@gmail.com
# Remitente. onboarding@resend.dev solo entrega al mail dueño de la cuenta de
# Resend; en producción usar un dominio verificado (ej. "Manté Web <web@mante.ar>").
CONTACT_FROM_EMAIL="Manté Web <onboarding@resend.dev>"

# Dominio público del sitio. Define la URL absoluta de og:image, twitter:image
# y del canonical. Sin esta variable se usa el dominio de producción de Vercel
# (y localhost en desarrollo).
NEXT_PUBLIC_SITE_URL=https://www.mante.ar
